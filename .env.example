# Server-only, configure in Netlify Function environment. Never prefix these with VITE_.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_APP_PASSWORD=
CONTACT_TO_EMAIL=
SITE_URL=
# Optional private Google Sheets CRM (share the sheet with this service account only)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
# Public verified business details, embedded at build time (not secrets)
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_SITE_URL=
